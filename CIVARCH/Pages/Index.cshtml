            <div class="ci-form-grid">
                <div class="ci-fg"><label>Příjmení *</label><input class="form-control" name="nz_Prijmeni" required /></div>
                <div class="ci-fg"><label>Jméno *</label><input class="form-control" name="nz_Jmeno" required /></div>
                <div class="ci-fg"><label>Titul</label><input class="form-control" name="nz_Titul" /></div>
                <div class="ci-fg"><label>Rodné příjmení</label><input class="form-control" name="nz_RodneJm" /></div>
                <div class="ci-fg"><label>Rodné číslo *</label><input class="form-control" name="nz_RC" required /></div>
            </div>

            <div class="ci-form-section">Kontaktní adresa</div>
