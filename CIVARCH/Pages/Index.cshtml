                <div class="ci-fg"><label>Ulice *</label><input class="form-control" name="nz_Adresa_Ulice" required /></div>
                <div class="ci-fg"><label>Číslo popisné *</label><input class="form-control" name="nz_Adresa_CP" required /></div>
                <div class="ci-fg"><label>Obec *</label><input class="form-control" name="nz_Adresa_Obec" required /></div>
                <div class="ci-fg"><label>PSČ *</label><input class="form-control" name="nz_Adresa_PSC" required /></div>
            </div>

            <div class="ci-form-section">Řízení</div>
