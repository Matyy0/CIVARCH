        <form method="get" action="" id="GoToPageFormBottom">
            <label for="pageJumpBottom">Přejít na:</label>
            <select id="pageJumpBottom" class="ci-page-select" name="Page" onchange="document.getElementById('GoToPageFormBottom').submit()">
                @for (int i = 1; i <= strankaPosledni; i++)
                {
                    if (i == strankaAktualni) { <option value="@i" selected>@i</option> }
                    else { <option value="@i">@i</option> }
                }
            </select>
            <input type="hidden" name="SearchQuery" value="@sq" />
            <input type="hidden" name="SortBy" value="@sortCol" />
            <input type="hidden" name="PageSize" value="@pageSize" />
        </form>
    </div>
    <div class="ci-page-jump">
        <label for="pageSizeSelectBottom">Záznamů na stránku:</label>
        <select id="pageSizeSelectBottom" class="ci-page-select" onchange="changePageSize(this.value)">
            @foreach (var sz in pageSizeOptions)
            {
                if (sz == pageSize) { <option value="@sz" selected>@sz</option> }
                else { <option value="@sz">@sz</option> }
            }
        </select>
    </div>
</div>

<script>
    // ── Navigace a řazení ──
    function navSort(col) {
        location.href = `?SearchQuery=@sq&SortBy=${col}&PageSize=@pageSize&Page=1`;
    }
    function changePageSize(size) {
        location.href = `?SearchQuery=@sq&SortBy=@sortCol&PageSize=${size}&Page=1`;
    }

    // ── DELETE MODAL ──
    function openDeleteModal(id) {
        document.getElementById("deleteId").value = id;
        const params = new URLSearchParams(window.location.search);
        document.getElementById("sortbyInput").value   = params.get("SortBy") ?? "";
        document.getElementById("searchInput").value   = params.get("SearchQuery") ?? "";
        document.getElementById("returnUrlInput").value = window.location.pathname + window.location.search;
        document.getElementById("deleteModal").style.display = "flex";
    }
    function closeDeleteModal() { document.getElementById("deleteModal").style.display = "none"; }

    // ── DETAIL MODAL ──
    let currentDetailId = null;

    async function openDetailModal(id) {
        currentDetailId = id;
        document.getElementById("detailModal").style.display = "flex";
        document.getElementById("detailModalBody").innerHTML = '<div class="ci-detail-loading">Načítám…</div>';
        document.getElementById("detailExportBtn").style.display = "none";

        const resp = await fetch(`/?handler=Detail&id=${id}`);
        if (!resp.ok) { document.getElementById("detailModalBody").innerHTML = "<p>Chyba při načítání.</p>"; return; }
        const d = await resp.json();
        if (!d.ok)  { document.getElementById("detailModalBody").innerHTML = `<p>${d.error}</p>`; return; }

        document.getElementById("detailModalTitle").textContent =
            [d.titul, d.jmeno, d.prijmeni].filter(Boolean).join(" ");

        document.getElementById("detailModalBody").innerHTML = `
            <div class="ci-detail-section">Osobní údaje</div>
            <table class="ci-detail-table">
                <tr><td>Jméno</td><td><strong>${d.jmeno} ${d.prijmeni}</strong></td></tr>
                ${d.titul ? `<tr><td>Titul</td><td>${d.titul}</td></tr>` : ""}
                ${d.rodneJm && d.rodneJm !== d.prijmeni ? `<tr><td>Rodné příjmení</td><td>${d.rodneJm}</td></tr>` : ""}
                <tr><td>Rodné číslo</td><td><code>${d.rc}</code></td></tr>
                <tr><td>Datum narození</td><td>${d.datumNarozeni}</td></tr>
                <tr><td>Adresa</td><td>${d.adresa}</td></tr>
            </table>
            <div class="ci-detail-section">Řízení</div>
            <table class="ci-detail-table">
                <tr><td>Organizace</td><td>${d.organizace}</td></tr>
                <tr><td>Podnik</td><td>${d.podnikNazev1}${d.podnikNazev2 ? " / " + d.podnikNazev2 : ""}</td></tr>
                <tr><td>Datum nástupu 1</td><td>${d.datNastupu1}</td></tr>
                ${d.datNastupu2 ? `<tr><td>Datum nástupu 2</td><td>${d.datNastupu2}</td></tr>` : ""}
                ${d.datum ? `<tr><td>Datum ukončení</td><td>${d.datum}</td></tr>` : ""}
                ${d.datVystaveno ? `<tr><td>Datum vystavení</td><td>${d.datVystaveno}</td></tr>` : ""}
                <tr><td>Stav</td><td>${d.stav}</td></tr>
            </table>
            <div class="ci-detail-section">Ostatní</div>
            <table class="ci-detail-table">
                <tr><td>Datum změny</td><td>${d.zmenaDatum}</td></tr>
                <tr><td>Autor změny</td><td>${d.zmenaAutor}</td></tr>
            </table>`;

        document.getElementById("detailExportBtn").style.display = "inline-flex";
    }

    function closeDetailModal() {
        document.getElementById("detailModal").style.display = "none";
        currentDetailId = null;
    }

    async function triggerExport(ids) {
        try {
            const resp = await fetch(`/Export?ids=${ids}`);
            if (!resp.ok) {
                const txt = await resp.text();
                alert(`Export selhal (HTTP ${resp.status}):\n${txt.substring(0, 300)}`);
                return;
            }
            const blob = await resp.blob();
            if (blob.size === 0) { alert('Export vrátil prázdný soubor.'); return; }
            const disposition = resp.headers.get('content-disposition') ?? '';
            const fnMatch = disposition.match(/filename[^;=\n]*=["']?([^"';\n]+)["']?/i);
            const fname = fnMatch ? fnMatch[1] : 'export.csv';
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url; a.download = fname;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        } catch(e) {
            alert('Chyba exportu: ' + e.message);
        }
    }

    function exportDetail() {
        if (!currentDetailId) return;
        triggerExport(currentDetailId);
    }

    function exportSelected() {
        const checked = [...document.querySelectorAll('.ci-checkbox:checked')];
        if (!checked.length) { alert('Vyberte alespoň jeden záznam.'); return; }
        triggerExport(checked.map(c => c.value).join(','));
    }

    // ── NOVÝ ZÁZNAM MODAL ──
    function openNovyModal()  { document.getElementById("novyModal").style.display = "flex"; }
    function closeNovyModal() { document.getElementById("novyModal").style.display = "none"; }

    document.getElementById("novyZaznamForm").addEventListener("submit", async function(e) {
        e.preventDefault();
        const btn = document.getElementById("novySubmitBtn");
        btn.disabled = true; btn.textContent = "Ukládám…";

        const resp = await fetch("/?handler=NovyZaznam", {
            method: "POST",
            body: new FormData(this)
        });
        const d = await resp.json();
        const msgEl = document.getElementById("novyModalMsg");

        if (d.ok) {
            msgEl.className = "ci-alert-success";
            msgEl.textContent = "Záznam byl úspěšně uložen.";
            msgEl.style.display = "block";
            this.reset();
            setTimeout(() => { closeNovyModal(); location.reload(); }, 1500);
        } else {
            msgEl.className = "ci-alert-error";
            msgEl.textContent = d.error || "Chyba při ukládání.";
            msgEl.style.display = "block";
        }
        btn.disabled = false; btn.textContent = "Uložit záznam";
    });

    // ── NOVÝ PODNIK MODAL ──
    function openNovyPodnikModal()  { document.getElementById("novyPodnikModal").style.display = "flex"; }
    function closeNovyPodnikModal() { document.getElementById("novyPodnikModal").style.display = "none"; }

    document.getElementById("novyPodnikForm").addEventListener("submit", async function(e) {
        e.preventDefault();
        const btn = document.getElementById("novyPodnikSubmitBtn");
        btn.disabled = true; btn.textContent = "Ukládám…";
        const resp = await fetch("/?handler=NovyPodnik", { method: "POST", body: new FormData(this) });
        const d = await resp.json();
        const msgEl = document.getElementById("novyPodnikModalMsg");
        if (d.ok) {
            msgEl.className = "ci-alert-success";
            msgEl.textContent = "Podnik byl úspěšně uložen.";
            msgEl.style.display = "block";
            this.reset();
            setTimeout(() => { closeNovyPodnikModal(); location.reload(); }, 1500);
        } else {
            msgEl.className = "ci-alert-error";
            msgEl.textContent = d.error || "Chyba při ukládání.";
            msgEl.style.display = "block";
        }
        btn.disabled = false; btn.textContent = "Uložit podnik";
    });

    // ── UPRAVIT ZÁZNAM MODAL ──
    async function openEditModal(id) {
        document.getElementById("editModal").style.display = "flex";
        document.getElementById("editModalLoading").style.display = "block";
        document.getElementById("editZaznamForm").style.display = "none";
        document.getElementById("editModalMsg").style.display = "none";

        const resp = await fetch(`/?handler=Detail&id=${id}`);
        if (!resp.ok) { document.getElementById("editModalLoading").textContent = "Chyba při načítání."; return; }
        const d = await resp.json();
        if (!d.ok) { document.getElementById("editModalLoading").textContent = d.error; return; }

        document.getElementById("editModalTitle").textContent =
            "Upravit: " + [d.titul, d.jmeno, d.prijmeni].filter(Boolean).join(" ");

        document.getElementById("uz_Id").value          = d.id;
        document.getElementById("uz_Prijmeni").value    = d.prijmeni || "";
        document.getElementById("uz_Jmeno").value       = d.jmeno || "";
        document.getElementById("uz_Titul").value       = d.titul || "";
        document.getElementById("uz_RodneJm").value     = d.rodneJm || "";
        document.getElementById("uz_RC").value          = d.rc || "";
        document.getElementById("uz_Adresa_Ulice").value = d.ulice || "";
        document.getElementById("uz_Adresa_CP").value   = d.cp || "";
        document.getElementById("uz_Adresa_Obec").value = d.adresaObec || "";
        document.getElementById("uz_Adresa_PSC").value  = d.psc || "";
        document.getElementById("refdocs2").value       = d.podnikNazev1 || "";

        function toDateInput(s) {
            if (!s) return "";
            const m = s.match(/^(\d{1,2})\.(\d{1,2})\.(\d{4})/);
            if (m) return `${m[3]}-${m[2].padStart(2,'0')}-${m[1].padStart(2,'0')}`;
            return s.split(' ')[0];
        }
        document.getElementById("uz_DatNastupu1").value = toDateInput(d.datNastupu1);
        document.getElementById("uz_DatNastupu2").value = toDateInput(d.datNastupu2);
        document.getElementById("uz_Datum").value       = toDateInput(d.datum);
        document.getElementById("uz_DatVystaveno").value = toDateInput(d.datVystaveno);

        const stavSel = document.getElementById("uz_Stav");
        for (let opt of stavSel.options) { opt.selected = opt.value === d.stav; }

        document.getElementById("editModalLoading").style.display = "none";
        document.getElementById("editZaznamForm").style.display = "block";
    }

    function closeEditModal() { document.getElementById("editModal").style.display = "none"; }

    document.getElementById("editZaznamForm").addEventListener("submit", async function(e) {
        e.preventDefault();
        const btn = document.getElementById("editSubmitBtn");
        btn.disabled = true; btn.textContent = "Ukládám…";
        const resp = await fetch("/?handler=UpravitZaznam", { method: "POST", body: new FormData(this) });
        const d = await resp.json();
        const msgEl = document.getElementById("editModalMsg");
        if (d.ok) {
            msgEl.className = "ci-alert-success";
            msgEl.textContent = "Záznam byl úspěšně upraven.";
            msgEl.style.display = "block";
            setTimeout(() => { closeEditModal(); location.reload(); }, 1500);
        } else {
            msgEl.className = "ci-alert-error";
            msgEl.textContent = d.error || "Chyba při ukládání.";
            msgEl.style.display = "block";
        }
        btn.disabled = false; btn.textContent = "Uložit změny";
    });

    // ── PODNIK AUTOCOMPLETE ──
    const podnikListJson = @Html.Raw(podnikListJson);

    (function() {
        const ulist = document.querySelector("#refdocs_list ul");
        function escapeRegex(t) { return t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }
        function renderList(filtered, search) {
            ulist.innerHTML = "";
            const re = new RegExp(escapeRegex(search), 'gi');
            filtered.forEach(name => {
                const li = document.createElement("li");
                li.innerHTML = name.replace(re, m => `<mark>${m}</mark>`);
                li.dataset.raw = name;
                ulist.appendChild(li);
            });
        }
        document.getElementById("refdocs").addEventListener("keyup", function() {
            const s = this.value.trim();
            if (s.length >= 3) {
                renderList(podnikListJson.filter(n => n.toLowerCase().includes(s.toLowerCase())).sort((a,b)=>a.localeCompare(b)), s);
            } else { ulist.innerHTML = ""; }
        });
        ulist.addEventListener("click", function(e) {
            const li = e.target.closest("li");
            if (!li) return;
            ulist.querySelectorAll("li").forEach(l => l.classList.remove("selected"));
            li.classList.add("selected");
            document.getElementById("refdocs").value = li.dataset.raw;
            ulist.innerHTML = "";
        });
    })();

    // ── PODNIK AUTOCOMPLETE (edit modal) ──
    (function() {
        const ulist2 = document.querySelector("#refdocs2_list ul");
        function escapeRegex(t) { return t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }
        document.getElementById("refdocs2").addEventListener("keyup", function() {
            const s = this.value.trim();
            if (s.length >= 3) {
                const re = new RegExp(escapeRegex(s), 'gi');
                const filtered = podnikListJson.filter(n => n.toLowerCase().includes(s.toLowerCase())).sort((a,b)=>a.localeCompare(b));
                ulist2.innerHTML = "";
                filtered.forEach(name => {
                    const li = document.createElement("li");
                    li.innerHTML = name.replace(re, m => `<mark>${m}</mark>`);
                    li.dataset.raw = name;
                    ulist2.appendChild(li);
                });
            } else { ulist2.innerHTML = ""; }
        });
        ulist2.addEventListener("click", function(e) {
            const li = e.target.closest("li");
            if (!li) return;
            ulist2.querySelectorAll("li").forEach(l => l.classList.remove("selected"));
            li.classList.add("selected");
            document.getElementById("refdocs2").value = li.dataset.raw;
            ulist2.innerHTML = "";
        });
    })();
</script>
