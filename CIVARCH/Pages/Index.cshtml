@* ══ TOOLBAR ══ *@
<div class="ci-toolbar">
    <form method="get" action="" class="ci-search-form">
        <input class="ci-search-input" type="text" name="SearchQuery"
               placeholder="&#128269; Hledat (lze bez diakritiky)…"
               value="@sq" />
        <input type="hidden" name="SortBy" value="@sortCol" />
        <button class="btn ci-btn-search" type="submit">Hledat</button>
        @if (!string.IsNullOrWhiteSpace(sq))
        {
            <a class="ci-btn-clear" href="?SortBy=@sortCol">&#10005; Zrušit filtr</a>
        }
    </form>
    <div class="ci-toolbar-right">
        @if (!string.IsNullOrWhiteSpace(sq))
        {
            <span class="ci-result-count">@celkovyPocet výsledků</span>
        }
        <button type="button" class="btn ci-btn-search" onclick="openNovyModal()" style="white-space:nowrap">+ Nový záznam</button>
        <button type="button" class="btn ci-btn-edit" onclick="openNovyPodnikModal()" style="white-space:nowrap">+ Nový podnik</button>
    </div>
</div>

@* ══ PAGINACE (NAHOŘE) ══ *@
<div class="ci-pagination-bar">
    <div class="ci-pager">
        @if (strankaAktualni > 1)
        {
            <button class="ci-page-btn" type="button" onclick="location.href='@(pageBase)&Page=1'" title="První">&#171;</button>
            <button class="ci-page-btn" type="button" onclick="location.href='@(pageBase)&Page=@(strankaAktualni-1)'" title="Předchozí">&#8249;</button>
        }
        else
        {
            <button class="ci-page-btn" disabled>&#171;</button>
            <button class="ci-page-btn" disabled>&#8249;</button>
        }
        <span class="ci-page-info">Stránka <strong>@strankaAktualni</strong> z <strong>@strankaPosledni</strong></span>
        @if (strankaAktualni < strankaPosledni)
        {
            <button class="ci-page-btn" type="button" onclick="location.href='@(pageBase)&Page=@(strankaDalsi)'" title="Další">&#8250;</button>
            <button class="ci-page-btn" type="button" onclick="location.href='@(pageBase)&Page=@(strankaPosledni)'" title="Poslední">&#187;</button>
        }
        else
        {
            <button class="ci-page-btn" disabled>&#8250;</button>
            <button class="ci-page-btn" disabled>&#187;</button>
        }
    </div>
    <div class="ci-page-jump">
        <form method="get" action="" id="GoToPageForm">
            <label for="pageJump">Přejít na:</label>
            <select id="pageJump" class="ci-page-select" name="Page" onchange="document.getElementById('GoToPageForm').submit()">
                @for (int i = 1; i <= strankaPosledni; i++)
                {
                    if (i == strankaAktualni) { <option value="@i" selected>@i</option> }
                    else { <option value="@i">@i</option> }
                }
            </select>
            <input type="hidden" name="SearchQuery" value="@sq" />
            <input type="hidden" name="SortBy" value="@sortCol" />
            <input type="hidden" name="PageSize" value="@pageSize" />
        </form>
    </div>
    <div class="ci-page-jump">
        <label for="pageSizeSelect">Záznamů na stránku:</label>
        <select id="pageSizeSelect" class="ci-page-select" onchange="changePageSize(this.value)">
            @foreach (var sz in pageSizeOptions)
            {
                if (sz == pageSize) { <option value="@sz" selected>@sz</option> }
                else { <option value="@sz">@sz</option> }
            }
        </select>
    </div>
</div>

@* ══ TABULKA ══ *@
<div class="ci-table-wrap">
    <table class="ci-table" id="tabulkaObcanu">
        <thead>
            <tr>
                <th class="ci-th-check"></th>
                @if (AppConfig.TableDisplayId)
                {
                    <th class="ci-th ci-sortable" onclick="navSort(3)">ID @(sortCol == 3 ? "▲" : "")</th>
                }
                <th class="ci-th">Titul</th>
                <th class="ci-th ci-sortable" onclick="navSort(0)">Jméno @(sortCol == 0 ? "▲" : "")</th>
                <th class="ci-th ci-sortable" onclick="navSort(1)">Příjmení @(sortCol == 1 ? "▲" : "")</th>
                <th class="ci-th ci-sortable" onclick="navSort(2)">Rodné číslo @(sortCol == 2 ? "▲" : "")</th>
                <th class="ci-th">Datum nar.</th>
                <th class="ci-th">Adresa</th>
                <th class="ci-th ci-th-actions">Akce</th>
            </tr>
        </thead>
        <tbody>
        @{
            async Task CreateTableRow(Obcan _obcan)
            {
                if (_obcan == null) return;
                string prijmeniText = (_obcan.RodneJm != "" && _obcan.RodneJm != _obcan.Prijmeni)
                    ? $"{_obcan.Prijmeni} ({_obcan.RodneJm})"
                    : _obcan.Prijmeni;

                <tr id="Zaznam_@_obcan.Id" class="ci-row">
                    <td class="ci-td-check">
                        <input type="checkbox" class="ci-checkbox" name="ExportId" value="@_obcan.Id" />
                    </td>
                    @if (AppConfig.TableDisplayId)
                    {
                        <td class="ci-td ci-id">@_obcan.Id</td>
                    }
                    <td class="ci-td ci-titul">@_obcan.Titul</td>
                    <td class="ci-td"><strong>@_obcan.Jmeno</strong></td>
                    <td class="ci-td">@prijmeniText</td>
                    <td class="ci-td ci-rc">@_obcan.RC</td>
                    <td class="ci-td ci-date">@_obcan.DatumNarozeni</td>
                    <td class="ci-td ci-adresa">@(_obcan.Adresa?.ToString() ?? "–")</td>
                    <td class="ci-td-actions">
                        <button class="btn ci-btn-view" type="button"
                                onclick="openDetailModal(@_obcan.Id)"
                                title="Zobrazit detail">&#128065; Detail</button>
                        <button class="btn ci-btn-edit" type="button"
                                onclick="openEditModal(@_obcan.Id)"
                                title="Upravit záznam">&#9998; Upravit</button>
                        <button class="btn ci-btn-del" type="button"
                                onclick="openDeleteModal(@_obcan.Id)"
                                title="Smazat záznam">&#128465; Smazat</button>
                    </td>
                </tr>
            }

            if (Obcane == null || Obcane.Count == 0)
            {
                <tr><td colspan="10" class="ci-empty">Žádné záznamy nenalezeny.</td></tr>
            }
            else
            {
                foreach (var o in Obcane) { await CreateTableRow(o); }
            }
        }
        </tbody>
    </table>
</div>
<div class="ci-export-bar">
    <button class="btn ci-btn-export" type="button" onclick="exportSelected()">&#8659; Exportovat vybrané do CSV</button>
    <span class="ci-export-hint">Zaškrtněte záznamy a klikněte Exportovat.</span>
</div>

