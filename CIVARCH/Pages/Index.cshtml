@page
@model CIVARCH.Pages.IndexModel
@{
    ViewData["Title"] = AppConfig.AppName;

    string searchQuery = " ";
    if (Request.Query["SearchQuery"].Count == 1)
        searchQuery = Request.Query["SearchQuery"].ToString();

    int? sortCol = Model.SortByColumn;
    string sortRequest = Request.Query["SortBy"].ToString();
    if (sortCol == null && !string.IsNullOrEmpty(sortRequest))
        sortCol = Convert.ToInt32(sortRequest);

    string sortby = sortCol switch
    {
        0 => "OBCAN_Jmeno",
        1 => "OBCAN_Prijmeni",
        2 => "OBCAN_RC",
        3 => "OBCAN_Id",
        _ => "OBCAN_Id"
    };

    int[] pageSizeOptions = { 10, 20, 50, 100, 200, 300 };
    int pageSize = AppConfig.TableRowsCount;
    if (Request.Query["PageSize"].Count == 1 && int.TryParse(Request.Query["PageSize"], out int _ps) && pageSizeOptions.Contains(_ps))
        pageSize = _ps;

    int celkovyPocet    = await DatabaseHandler.LoadObcaneCount(searchQuery);
    int strankaAktualni = 1;
    if (Request.Query["Page"].Count == 1)
        strankaAktualni = Convert.ToInt32(Request.Query["Page"]);
    int strankaDalsi    = strankaAktualni + 1;
    int strankaPosledni = (int)Math.Ceiling((double)celkovyPocet / pageSize);
    if (strankaPosledni < 1) strankaPosledni = 1;

    List<Obcan> Obcane = await DatabaseHandler.LoadObcaneListQuery(
        (strankaAktualni - 1) * pageSize + 1,
        strankaAktualni * pageSize,
        searchQuery, sortby);

    List<CisStav> Stavy = await DatabaseHandler.LoadStavy();

    string sq       = searchQuery?.Trim() ?? "";
    string pageBase = $"?SearchQuery={sq}&SortBy={sortCol}&PageSize={pageSize}";

    string podnikListJson = System.Text.Json.JsonSerializer.Serialize(
        DatabaseHandler.LoadPodnikNames().GetAwaiter().GetResult());
}

@* ══ CHYBOVÉ HLÁŠENÍ Z MAZÁNÍ ══ *@
@if (Model.DeleteError != null)
{
    <div class="ci-alert-error" id="deleteErrorAlert">
        &#9888; @Model.DeleteError
        <button type="button" onclick="this.parentElement.remove()" class="ci-alert-close">&#10005;</button>
    </div>
}

@* ══ MODAL: SMAZAT ZÁZNAM ══ *@
<div id="deleteModal" class="ci-modal-backdrop" style="display:none" onclick="if(event.target===this)closeDeleteModal()">
    <div class="ci-modal-box">
        <div class="ci-modal-header">
            <span class="ci-modal-icon">&#9888;</span>
            <h5 class="ci-modal-title">Smazat záznam</h5>
        </div>
        <p class="ci-modal-body">Opravdu chcete smazat tento záznam? Tuto akci nelze vrátit zpět.</p>
        <form method="post" action="/?handler=DeleteObcan" class="ci-modal-actions">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id"          id="deleteId" />
            <input type="hidden" name="sortby"      id="sortbyInput" />
            <input type="hidden" name="returnUrl"   id="returnUrlInput" />
            <input type="hidden" name="searchQuery" id="searchInput" />
            <button type="button" class="btn ci-btn-ghost" onclick="closeDeleteModal()">Zrušit</button>
            <button type="submit" class="btn ci-btn-danger">Smazat</button>
        </form>
    </div>
</div>

