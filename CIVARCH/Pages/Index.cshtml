                    <div id="refdocs_main">
                        <div id="refdocs_input"><input id="refdocs" name="nz_Rizeni_Podnik" required /></div>
                        <div id="refdocs_wrapper"><div id="refdocs_list"><ul></ul></div></div>
                    </div>
                </div>
                <div class="ci-fg"><label>Datum nástupu 1 *</label><input class="form-control" type="date" name="nz_Rizeni_DatNastupu1" required /></div>
                <div class="ci-fg"><label>Datum nástupu 2</label><input class="form-control" type="date" name="nz_Rizeni_DatNastupu2" /></div>
                <div class="ci-fg"><label>Datum ukončení</label><input class="form-control" type="date" name="nz_Rizeni_Datum" /></div>
                <div class="ci-fg"><label>Datum vystavení</label><input class="form-control" type="date" name="nz_Rizeni_DatVystaveno" /></div>
                <div class="ci-fg">
                    <label>Stav *</label>
                    <select class="form-control" name="nz_Rizeni_Stav">
                        @foreach (CisStav cs in Stavy)
                        {
                            <option value="@cs.Kod">@cs.Name</option>
